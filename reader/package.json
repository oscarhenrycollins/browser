{
  "name": "wizard-browser-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "corpus:report": "READER_CORPUS_REPORT=1 node --test test/corpus.test.mjs",
    "corpus:live": "python3 test/capture-corpus.py && node --test test/corpus.test.mjs"
  },
  "dependencies": {
    "@asamuzakjp/dom-selector": "10.0.5",
    "@mozilla/readability": "0.6.0",
    "defuddle": "0.19.6",
    "dompurify": "3.4.17",
    "ipaddr.js": "2.5.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1"
  }
}
